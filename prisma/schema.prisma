// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  name      String   @db.VarChar(255)
  password  String   @db.VarChar(255) // Will be hashed
  role      UserRole @default(ADMIN)
  isActive  Boolean  @default(true) @map("is_active")
  adminId   String?  @map("admin_id") // Reference to admin user (null for admin users)
  customerId String? @map("customer_id") // Billable account this user belongs to
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  admin    User?  @relation("AdminMembers", fields: [adminId], references: [id], onDelete: Cascade)
  members  User[] @relation("AdminMembers")
  customer Customer? @relation(fields: [customerId], references: [id])

  // User can own accounts (only admins can create accounts)
  accounts Account[]
  // Per-account access grants (which accounts a non-admin user can see/act on)
  accountAccess AccountAccess[]

  @@index([email], name: "idx_users_email")
  @@index([role], name: "idx_users_role")
  @@index([adminId], name: "idx_users_admin_id")
  @@index([customerId], name: "idx_users_customer_id")
  @@index([isActive], name: "idx_users_active")
  @@map("users")
}

// Billable account (tenant). Holds the subscription and the root/owner email.
// All users sharing a customerId belong to the same billable account, which can
// therefore have multiple ADMINs. The root user is the one whose email == rootEmail.
model Customer {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  rootEmail String   @map("root_email") @db.VarChar(255)
  plan      String   @default("FREE") @db.VarChar(50)
  status    String   @default("ACTIVE") @db.VarChar(50) // active for everyone, for now
  onboardingDismissed Boolean @default(false) @map("onboarding_dismissed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  subscriptionEvents SubscriptionEvent[]

  @@index([rootEmail], name: "idx_customers_root_email")
  @@map("customers")
}

// Subscription/billing history for a billable account (root user only can view).
model SubscriptionEvent {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  plan       String   @db.VarChar(50)
  type       String   @db.VarChar(50) // ACTIVATED | PLAN_CHANGED | RENEWED | CANCELLED
  amount     Decimal? @db.Decimal(10, 2)
  currency   String?  @db.VarChar(3)
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], name: "idx_subevents_customer")
  @@index([createdAt], name: "idx_subevents_created")
  @@map("subscription_events")
}

// Audit trail of write actions (web, admin-only view). Not FK-linked so logs
// survive deletion of the referenced resource/user.
model AuditLog {
  id         String   @id @default(cuid())
  customerId String?  @map("customer_id")
  actorId    String?  @map("actor_id")
  actorEmail String   @map("actor_email") @db.VarChar(255)
  action     String   @db.VarChar(20) // CREATE | UPDATE | DELETE
  resource   String   @db.VarChar(50) // entry | account | category | user
  resourceId String?  @map("resource_id")
  summary    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId], name: "idx_audit_customer")
  @@index([createdAt], name: "idx_audit_created")
  @@map("audit_logs")
}

model Account {
  id          String      @id @default(cuid())
  userId      String      @map("user_id") // Owner of the account (admin user)
  customerId  String?     @map("customer_id") // Billable account this account belongs to (denormalised from owner)
  handle      String?     @unique @db.VarChar(64) // Globally-unique @handle for transfers (e.g. anyirah)
  mode        AccountMode @default(PERSONAL) // Drives the app experience: personal tracker vs business P&L
  name        String      @db.VarChar(255)
  description String?     @db.Text
  type        AccountType @default(PERSONAL)
  currency    String      @default("NGN") @db.VarChar(3)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relationships
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   Category[]
  entries      Entry[]
  access       AccountAccess[]

  @@index([userId], name: "idx_accounts_user_id")
  @@index([customerId], name: "idx_accounts_customer_id")
  @@index([type], name: "idx_accounts_type")
  @@index([isActive], name: "idx_accounts_active")
  @@index([createdAt], name: "idx_accounts_created_at")
  @@map("accounts")
}

// Grants a (non-admin) user access to a specific account. Admins implicitly have
// access to every account in their customer, so they get no rows here. The user's
// global role (EDITOR/VIEWER) still decides capability; this decides scope.
model AccountAccess {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  accountId String   @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId], name: "unique_user_account")
  @@index([userId], name: "idx_access_user")
  @@index([accountId], name: "idx_access_account")
  @@map("account_access")
}

// In-app notification. One row per recipient so read state is per-user. Not
// FK-linked (like AuditLog) so it survives deletion of the referenced entry/user.
model Notification {
  id          String    @id @default(cuid())
  customerId  String?   @map("customer_id")
  recipientId String    @map("recipient_id") // user who should see it
  actorId     String?   @map("actor_id")
  actorName   String    @map("actor_name") @db.VarChar(255)
  action      String    @db.VarChar(20) // CREATE | UPDATE | DELETE
  resource    String    @db.VarChar(50) // entry
  resourceId  String?   @map("resource_id")
  accountId   String?   @map("account_id")
  accountName String?   @map("account_name") @db.VarChar(255)
  summary     String?   @db.Text
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([recipientId, readAt], name: "idx_notif_recipient")
  @@index([customerId], name: "idx_notif_customer")
  @@index([createdAt], name: "idx_notif_created")
  @@map("notifications")
}

model Category {
  id        String      @id @default(cuid())
  accountId String      @map("account_id")
  name      String      @db.VarChar(255)
  type      CategoryType
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  
  // Relationships
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries      Entry[]
  items        CategoryItem[]

  @@unique([accountId, name, type], name: "unique_account_name_type")
  @@index([accountId], name: "idx_categories_account_id")
  @@index([type], name: "idx_type")
  @@index([name], name: "idx_name")
  @@index([createdAt], name: "idx_created_at")
  @@map("categories")
}

model Entry {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  date       DateTime @db.Date
  note       String   @db.Text
  categoryId String   @map("category_id")
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  // Relationships
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items      EntryItem[]

  @@index([accountId], name: "idx_transactions_account_id")
  @@index([date], name: "idx_date")
  @@index([categoryId], name: "idx_category")
  @@index([amount], name: "idx_amount")
  @@index([createdAt], name: "idx_created_at")
  @@map("entries")
}

// A handle-addressed transfer between two accounts. The sender's EXPENSE entry
// is created immediately; the recipient's INCOME entry is created only when they
// accept. On reject the sender's expense is reversed. Loosely linked (no FKs) so
// it survives entry/account deletion. Accounts may be in different customers.
model Transfer {
  id              String    @id @default(cuid())
  fromAccountId   String    @map("from_account_id")
  toAccountId     String    @map("to_account_id")
  fromEntryId     String?   @map("from_entry_id") // sender's expense entry (reversed on reject)
  toEntryId       String?   @map("to_entry_id") // recipient's income entry (created on accept)
  amount          Decimal   @db.Decimal(10, 2)
  note            String?   @db.Text
  date            DateTime  @db.Date
  status          String    @default("PENDING") @db.VarChar(20) // PENDING | ACCEPTED | REJECTED
  senderId        String?   @map("sender_id")
  senderName      String    @map("sender_name") @db.VarChar(255)
  fromAccountName String?   @map("from_account_name") @db.VarChar(255)
  toHandle        String?   @map("to_handle") @db.VarChar(64)
  decidedById     String?   @map("decided_by_id")
  decidedByName   String?   @map("decided_by_name") @db.VarChar(255)
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([toAccountId, status], name: "idx_transfer_to_status")
  @@index([fromAccountId], name: "idx_transfer_from")
  @@index([createdAt], name: "idx_transfer_created")
  @@map("transfers")
}

// A scheduled entry. The cron job drafts it on nextRunOn (into the inbox, or
// posts it directly when autoPost). Loosely linked (no FKs) like the other
// recent models. amount null => "ask me" (a placeholder draft to fill in).
model RecurringTemplate {
  id          String    @id @default(cuid())
  customerId  String?   @map("customer_id")
  accountId   String    @map("account_id")
  categoryId  String    @map("category_id")
  type        CategoryType
  amount      Decimal?  @db.Decimal(10, 2)
  note        String?   @db.Text
  cadence     String    @db.VarChar(20) // DAILY | WEEKLY | MONTHLY | YEARLY
  dayOfMonth  Int?      @map("day_of_month") // 1..31 (clamped to month length)
  dayOfWeek   Int?      @map("day_of_week") // 0..6 (Sun..Sat)
  autoPost    Boolean   @default(false) @map("auto_post")
  active      Boolean   @default(true)
  nextRunOn   DateTime  @map("next_run_on") @db.Date
  lastRunOn   DateTime? @map("last_run_on") @db.Date
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([active, nextRunOn], name: "idx_recurring_due")
  @@index([accountId], name: "idx_recurring_account")
  @@index([customerId], name: "idx_recurring_customer")
  @@map("recurring_templates")
}

// A pending entry awaiting review in the inbox. Approving it creates a real
// Entry; dismissing drops it. Fed by recurring (now) and SMS/OCR/import (later).
model DraftEntry {
  id            String   @id @default(cuid())
  customerId    String?  @map("customer_id")
  accountId     String   @map("account_id")
  categoryId    String?  @map("category_id") // suggested category (may be null)
  suggestedConf Float?   @map("suggested_conf") // 0..1 classifier confidence
  type          CategoryType
  amount        Decimal? @db.Decimal(10, 2)
  note          String?  @db.Text
  date          DateTime @db.Date
  source        String   @db.VarChar(20) // RECURRING | SMS | OCR | IMPORT | MANUAL
  status        String   @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | DISMISSED
  fingerprint   String   @db.VarChar(64)
  templateId    String?  @map("template_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([customerId, status], name: "idx_draft_customer_status")
  @@index([accountId, status], name: "idx_draft_account_status")
  @@index([fingerprint], name: "idx_draft_fingerprint")
  @@map("draft_entries")
}

// Business mode: a sale/order (revenue). Lean P&L = orders − costs.
model Order {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  customerId   String?  @map("customer_id")
  reference    String?  @db.VarChar(64) // order / invoice number
  customerName String?  @map("customer_name") @db.VarChar(255)
  date         DateTime @db.Date
  amount       Decimal  @db.Decimal(12, 2) // revenue for this order
  status       String   @default("PAID") @db.VarChar(20) // PAID | PENDING | CANCELLED
  note         String?  @db.Text
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([accountId, date], name: "idx_order_account_date")
  @@index([accountId, status], name: "idx_order_account_status")
  @@map("orders")
}

// Business mode: a cost / expenditure that reduces profit.
model Cost {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  customerId  String?  @map("customer_id")
  category    String?  @db.VarChar(255)
  note        String?  @db.Text
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([accountId, date], name: "idx_cost_account_date")
  @@map("costs")
}

// One row per day a "record your income/expenses" reminder push was sent —
// guards the daily reminder cron to exactly one send per Lagos calendar day.
model ReminderLog {
  date   DateTime @id @db.Date
  sentAt DateTime @default(now()) @map("sent_at")

  @@map("reminder_log")
}

// FCM device registration tokens for push notifications (one per device/login).
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(512)
  platform  String   @default("android") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId], name: "idx_devicetoken_user")
  @@map("device_tokens")
}

// Reusable catalog of items under a category (e.g. Milk under Groceries).
model CategoryItem {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  name       String   @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name], name: "unique_category_item")
  @@index([categoryId], name: "idx_catitem_category")
  @@map("category_items")
}

// Optional per-entry line items breaking down the entry amount. The sum of item
// amounts must not exceed the entry's amount (remainder stays unitemized).
model EntryItem {
  id             String   @id @default(cuid())
  entryId        String   @map("entry_id")
  categoryItemId String?  @map("category_item_id") // catalog item, if picked
  name           String   @db.VarChar(255)
  amount         Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId], name: "idx_entryitem_entry")
  @@map("entry_items")
}

enum AccountType {
  PERSONAL
  BUSINESS
  SAVINGS
  CHECKING
  CREDIT
  INVESTMENT
}

// The app experience an account drives. PERSONAL = the income/expense tracker;
// BUSINESS = the orders/costs/P&L flow.
enum AccountMode {
  PERSONAL
  BUSINESS
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}
