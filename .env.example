# Environment Configuration
# Copy this to .env.local for local development

# Database Configuration
DATABASE_URL="mysql://root:password@localhost:3306/luka_categories"

# Public variables (accessible in browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker Compose Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=luka_categories
MYSQL_USER=luka_user
MYSQL_PASSWORD=luka_password
MYSQL_PORT=3306

# Application Ports
APP_DEV_PORT=3000
APP_PROD_PORT=3001

# Container Names
MYSQL_CONTAINER_NAME=luka-mysql
APP_CONTAINER_NAME=luka-app

# Note: NODE_ENV is automatically set by Next.js:
# - "development" when running `npm run dev`
# - "production" when running `npm start` or in Vercel
# You don't need to set NODE_ENV manually

# For Production (set these in Vercel dashboard):
# DATABASE_URL="mysql://username:password@production-host:3306/database"
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
